[Unit]
Description=ctxgate-dashboard (health monitoring GUI)
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=notify
EnvironmentFile=/etc/ctxgate-proxy/.env
WorkingDirectory=/opt/ctxgate-proxy
ExecStart=/opt/ctxgate-proxy/venv/bin/python -u /opt/ctxgate-proxy/dashboard/dashboard.py
Restart=on-failure
RestartSec=5
WatchdogSec=30
StandardOutput=append:/var/log/ctxgate-proxy/dashboard.log
StandardError=append:/var/log/ctxgate-proxy/dashboard.log

[Install]
WantedBy=multi-user.target