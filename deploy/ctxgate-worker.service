[Unit]
Description=ctxgate-worker — 4B durable-memory extraction worker
After=network.target postgresql.service
Wants=network.target postgresql.service

[Service]
Type=simple
Restart=always
RestartSec=5
StartLimitBurst=0
TimeoutStopSec=30
KillMode=mixed
WorkingDirectory=/opt/ctxgate-proxy
EnvironmentFile=-/etc/ctxgate-proxy/env
ExecStart=/usr/bin/python3 -u worker/worker.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ctxgate-worker
# The worker is low priority. It should never compete with vLLM or the proxy.
CPUWeight=50
MemoryMax=1G

[Install]
WantedBy=multi-user.target
