[Unit]
Description=ctxgate-dashboard — health-monitoring GUI with service control
After=network.target postgresql.service
Wants=network.target postgresql.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60
Restart=always
RestartSec=5
StartLimitBurst=0
TimeoutStopSec=30
KillMode=mixed
WorkingDirectory=/opt/ctxgate-proxy
EnvironmentFile=-/etc/ctxgate-proxy/env
ExecStart=/usr/bin/python3 -u dashboard/dashboard.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ctxgate-dashboard
MemoryMax=1G

[Install]
WantedBy=multi-user.target
