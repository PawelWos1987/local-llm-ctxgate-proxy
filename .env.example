# ctxgate-proxy environment configuration
# Copy to .env and fill in values. Never commit .env to git.

# === DATABASE ===
# PostgreSQL DSN. Required. Must not contain CHANGE_ME.
# Format: postgresql://user:password@host:port/dbname
CTXGATE_DB_DSN=postgresql://ctxgate:CHANGE_ME@127.0.0.1:5432/ctxproxy

# Database connection retry window (seconds). Total retry must be < 90s (systemd TimeoutStartSec).
CTXGATE_DB_WAIT_SECONDS=60

# === TOKENIZER ===
# Path to Qwen tokenizer.json. REQUIRED. No fallback allowed.
# Must be an existing readable file.
CTXGATE_QWEN_TOKENIZER=/path/to/tokenizer.json

# === VLLM UPSTREAM ===
VLLM_URL=http://127.0.0.1:8000
VLLM_MODEL=Qwen/Qwen3-8B
VLLM_API_KEY=

# === SERVER ===
# Bind address. Use 127.0.0.1 for local-only.
CTXGATE_HOST=127.0.0.1
CTXGATE_PORT=9201

# === AUTHENTICATION ===
# Option A: Legacy single-key mode (tenant "local")
# CTXGATE_API_KEY=your-single-key

# Option B: Multi-tenant labelled keys
# Format: label=key,label2=key2
# Labels must match [a-z0-9_-]{1,32}
# CTXGATE_API_KEYS=alice=sk-alice-key,bob=sk-bob-key

# Admin key for /metrics and /api/* endpoints (required in key mode)
# CTXGATE_ADMIN_KEY=sk-admin-key

# Option C: Explicit local no-auth mode (NEVER use behind reverse proxy)
# Requires CTXGATE_HOST to be loopback (127.0.0.1 or ::1)
# CTXGATE_ALLOW_NO_AUTH=1

# === SESSION IDENTITY ===
# goose (default): Use X-Session-ID header or Goose SQLite lookup
# hash: Deterministic sha256-based identity, no SQLite on request path
CTXGATE_SESSION_IDENTITY=goose

# Goose metadata enrichment (background only, requires SQLite access)
# CTXGATE_GOOSE_INTEGRATION=1

# === EXTERNAL LM ===
# Enable/disable external LM calls (summarization, knowledge extraction)
# 1 = enabled (default), 0 = disabled (no LM calls, worker idles)
CTXGATE_LM_ENABLED=1
LM_URL=http://127.0.0.1:8000
LM_MODEL=Qwen/Qwen3-8B
LM_API_KEY=

# === PER-TENANT LIMITS (all 0 = disabled) ===
# Token bucket rate limit per tenant (tokens/sec)
CTXGATE_TENANT_RATE_PER_SEC=0
# Token bucket burst size
CTXGATE_TENANT_RATE_BURST=0
# Max concurrent requests per tenant
CTXGATE_TENANT_MAX_CONCURRENCY=0

# === UNICODE ESCAPE DIAGNOSTICS ===
# 0 = diagnostic only (count and log), 1 = block calls with unicode escapes
CTXGATE_BLOCK_UNICODE_ESCAPES=0

# === TEST ENDPOINTS ===
# Register /_test/* routes (for integration testing)
# CTXGATE_TEST_ENDPOINTS=1

# === WORKER ===
# Worker poll interval (seconds)
CTXGATE_WORKER_POLL=2.0
# Number of concurrent consumers
CTXGATE_WORKER_CONSUMERS=4
# Max attempts before marking job as failed
CTXGATE_WORKER_MAX_ATTEMPTS=5
# Outage TTL (seconds) - how long to wait before retrying failed jobs
CTXGATE_WORKER_OUTAGE_TTL=3600
# Quality check temperature
CTXGATE_WORKER_QC_TEMP=0.0
# Quality check max tokens
CTXGATE_WORKER_QC_MAX_TOKENS=256
